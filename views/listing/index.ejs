<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>All Listings</h3>
    <form method="GET" action="/Listing/new">
        <button>Create New List</button>
    </form>
<ul>
    <% for(let l of allListing){ %>
        <li>
            <a href="/listing/<%= l._id %>"><%= l.title %></a> — 
            <a href="/listing/edit/<%= l._id %>">edit</a> — 
            <form action="/listing/<%= l._id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this listing?');">
                Delete
                </button>
            </form>
        </li>
        <br>
    <% } %>
</ul>


</body>
</html>