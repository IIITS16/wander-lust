
<% layout("layouts/boilerplate") %>

<body>
    <h3>All Listings</h3>
    <!-- <form method="GET" action="/Listing/new">
        <button>Create New List</button> -->
    <!-- </form> -->

<!-- Card -->

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 ">

     <% for(let l of allListing){ %>
        <a href="/Listing/<%= l._id %>" class="listing-link">
            <div class="card col" style="width: 20rem;">
                <img class="card-img-top" src="<%= l.image %>" alt="Listing_image" style = "height: 20rem ">
                <div class="card-img-overlay"></div>

                <div class="card-body">
                <p class="card-text">
                    <b><%= l.title %> </b><br>
                    &#8377 <%= l.price %> / night
                </p>
                </div>
            </div>
    <% } %>
</a>

</div>



<ul>
    <% for(let l of allListing){ %>
        <li>
            <a href="/listing/<%= l._id %>"><%= l.title %></a> — 
            <a href="/listing/edit/<%= l._id %>">edit</a> — 
            <form action="/listing/<%= l._id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this listing?');">
                Delete
                </button>
            </form>
        </li>
        <br>
    <% } %>
</ul>


</body>
