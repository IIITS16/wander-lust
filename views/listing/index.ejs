<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>All Listings</h3>
    <form method="GET" action="/Listing/new">
        <button>Create New List</button>
    </form>
<ul>
    <% for(let l of allListing){ %>
        <li><a href="/listing/<%= l._id %>"><%= l.title %></a></li>
        <br>
    <% } %>
</ul>

</body>
</html>