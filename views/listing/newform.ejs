<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>Create a New Listing</h3>
    <form action="/Listing" method="POST">
        <input type="text" name="incdata[title]" placeholder="Enter Title">
        <br>
        <input type="text" name="incdata[description]" placeholder="Enter description">
        <br>
        <input type="number" name="incdata[price]" placeholder="Enter price">
        <br>
        <input type="text" name="incdata[location]" placeholder="Enter location">
        <br>
        <input type="text" name="incdata[country]" placeholder="Enter country">
        <br>

        <button>submit</button>
    </form>
</body>
</html>